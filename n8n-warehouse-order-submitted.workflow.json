                  {
                      "parameters":  {
                                         "jsCode":  "const SHARED_SECRET = \u0027b7472f1c848df4212df932a172927a96717898d28a5917d3b3131725e1c4100f\u0027;\nconst headers = $json.headers || {};\nconst body = $json.body || $json;\nconst incomingSecret = headers[\u0027x-warehouse-secret\u0027] || headers[\u0027X-Warehouse-Secret\u0027] || \u0027\u0027;\n\nif (incomingSecret !== SHARED_SECRET) {\n  return [{\n    json: {\n      ok: false,\n      authorized: false,\n      statusCode: 401,\n      message: \u0027Invalid X-Warehouse-Secret\u0027\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    authorized: true,\n    receivedAt: new Date().toISOString(),\n    order: body,\n    flags: body.flags || {},\n    totals: body.totals || {},\n    branch: body.branch || {},\n    items: body.items || []\n  }\n}];"
                                     },
                      "id":  "6f8cbe07-8b95-44d6-verify-secret",
                      "name":  "Verify Secret + Normalize",
                      "type":  "n8n-nodes-base.code",
