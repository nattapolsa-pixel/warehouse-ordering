                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const order = $json.order || {};\nconst branch = order.branch || {};\nconst totals = order.totals || {};\nconst cycle = order.cycle || {};\nconst items = order.items || [];\nconst lines = items.slice(0, 12).map(item =\u003e {\n  return `• ${item.itemCode} ${item.itemName || \u0027\u0027} x ${item.qty}${item.uom ? \u0027 \u0027 + item.uom : \u0027\u0027}`;\n});\nconst extra = items.length \u003e 12 ? `\\n...และอีก ${items.length - 12} รายการ` : \u0027\u0027;\nconst alertReasons = [];\nif (totals.isOutOfCycle) alertReasons.push(\u0027ไม่ใช่รอบสั่งของสาขา\u0027);\nif (totals.missingMasterCount \u003e 0) alertReasons.push(`มีสินค้าไม่พบ Master ${totals.missingMasterCount} รายการ`);\n\nreturn [{\n  json: {\n    order,\n    shouldAlertAdmin: !!(order.flags \u0026\u0026 order.flags.shouldAlertAdmin),\n    isOutOfCycle: !!totals.isOutOfCycle,\n    hasMissingMasterItem: !!(order.flags \u0026\u0026 order.flags.hasMissingMasterItem),\n    subject: `[${order.owner}] New Order ${order.documentNo} - ${branch.code || \u0027\u0027}`,\n    branchSummary: `${branch.code || \u0027\u0027} ${branch.name || \u0027\u0027}`.trim(),\n    alertReasons,\n    message: [\n      `New warehouse order: ${order.documentNo}`,\n      `Owner: ${order.ownerLabel || order.owner || \u0027-\u0027}`,\n      `Branch: ${branch.code || \u0027-\u0027} ${branch.name || \u0027\u0027}`,\n      `Province: ${branch.province || \u0027-\u0027}`,\n      `Cycle: ${cycle.status || \u0027-\u0027}`,\n      `Items: ${totals.itemCount || items.length} | Total Qty: ${totals.totalQty || 0}`,\n      alertReasons.length ? `Alert: ${alertReasons.join(\u0027, \u0027)}` : \u0027Alert: -\u0027,\n      \u0027\u0027,\n      lines.join(\u0027\\n\u0027) + extra\n    ].join(\u0027\\n\u0027)\n  }\n}];"
                                     },
